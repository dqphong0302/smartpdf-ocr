# ── OCR Engine ────────────────────────────────────────────
# Language for Tesseract OCR (e.g. eng, vie, eng+vie)
TESSERACT_LANG=eng+vie

# Minimum confidence threshold (0-100) for Tesseract; below this → fallback to Vision AI
CONFIDENCE_THRESHOLD=80

# ── 9router / Vision AI ───────────────────────────────────
# Base URL of your OpenAI-compatible Vision AI gateway
NINE_ROUTER_URL=https://your-9router-or-openai-gateway.example.com/v1

# API key for the Vision AI gateway
NINE_ROUTER_API_KEY=replace-with-a-secret-from-your-runtime-secret-store

# Vision model to use for complex scan OCR
VISION_MODEL=gpt-4o-mini

# ── Upload limits ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500
MAX_CONCURRENT_JOBS=2
MAX_TESSERACT_WORKERS=2
PARALLEL_BATCHES=2
BATCH_SIZE=4
JOB_MAX_AGE_DAYS=7

# ── Auth ──────────────────────────────────────────────────
# API key required for MCP / programmatic access
OCR_API_KEY=replace-with-a-long-random-secret

# Explicit credentials are required; there are no application defaults.
SMART_PDF_ADMIN_USER=replace-with-admin-username
SMART_PDF_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# ── Cookie / Session ──────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.example.com

# Disable interactive API documentation on public deployments.
ENABLE_API_DOCS=false

# Keep disabled unless the service is running as a dedicated non-root user
# with the supplied systemd hardening and TeX resource restrictions.
LATEX_COMPILE_ENABLED=false
