# ── OCR Engine ────────────────────────────────────────────
# Language for Tesseract OCR (e.g. eng, vie, eng+vie)
TESSERACT_LANG=eng+vie

# Minimum confidence threshold (0-100) for Tesseract; below this → fallback to Vision AI
CONFIDENCE_THRESHOLD=80

# ── 9router / Vision AI ───────────────────────────────────
# Base URL of your OpenAI-compatible Vision AI gateway
NINE_ROUTER_URL=https://your-9router-or-openai-gateway.example.com/v1

# API key for the Vision AI gateway
NINE_ROUTER_API_KEY=sk-your-api-key-here

# Vision model to use for complex scan OCR
VISION_MODEL=gpt-4o-mini

# ── Upload limits ─────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Auth ──────────────────────────────────────────────────
# API key required for MCP / programmatic access
OCR_API_KEY=sk-change-me-in-production

# Default admin credentials (change these immediately!)
SMART_PDF_ADMIN_USER=admin
SMART_PDF_ADMIN_PASSWORD=change-me-in-production

# ── Cookie / Session ──────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.example.com
